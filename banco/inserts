-- -----------------------------------------------------
-- Inserindo prescrições (vinculando medicamento e cuidado)
-- -----------------------------------------------------
INSERT INTO banco.prescricao
(
    medicamento_medicamento_id,
    cuidado_cuidado_id,
    cuidado_fk_pessoa_paciente,
    cuidado_fk_pessoa_cuidador,
    prescricao_frequencia,
    prescricao_dosagem,
    prescricao_horario_primeira_dose,
    prescricao_data_inicio,
    prescricao_observacao,
    prescricao_tomada
)
SELECT
    m.medicamento_id,
    c.cuidado_id,
    c.fk_pessoa_paciente,
    c.fk_pessoa_cuidador,
    8,
    1.0,
    '2026-10-27 08:00:00',
    '2026-10-27',
    'Prescrição de teste',
    0
FROM banco.medicamento AS m
CROSS JOIN banco.cuidado AS c
WHERE NOT EXISTS (
    SELECT 1
    FROM banco.prescricao AS p
    WHERE p.medicamento_medicamento_id = m.medicamento_id
      AND p.cuidado_cuidado_id = c.cuidado_id
      AND p.cuidado_fk_pessoa_paciente = c.fk_pessoa_paciente
      AND p.cuidado_fk_pessoa_cuidador = c.fk_pessoa_cuidador
)
ORDER BY m.medicamento_id, c.cuidado_id
LIMIT 15;